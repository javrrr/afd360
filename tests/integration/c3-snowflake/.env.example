# Copy to .env.local (gitignored) and fill in. Values are also pulled from
# afd360-training/.env if you've already set things up there.
#
# authenticationOption = "KeyPair"  (the only combination wired up here)

SNOWFLAKE_ACCOUNT_URL=
# e.g. xy12345.eu-west-1.aws.snowflakecomputing.com

SNOWFLAKE_USER=
SNOWFLAKE_WAREHOUSE=

# Absolute or ~/path to the PKCS#8 private key (.p8). The file is read at
# deploy time via ${file:...}; contents are never stored in .env.local.
SNOWFLAKE_PRIVATE_KEY_PATH=

# Optional — only if the key is passphrase-protected.
SNOWFLAKE_PASSPHRASE=
