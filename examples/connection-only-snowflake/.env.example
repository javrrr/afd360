# Copy to `.env` (gitignored) before running `afd360 deploy`.

SNOWFLAKE_ACCOUNT_URL=          # e.g. xy12345.eu-central-1.snowflakecomputing.com
SNOWFLAKE_USER=                 # must have keypair auth configured server-side
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_REGION=               # e.g. eu-central-1
SNOWFLAKE_PRIVATE_KEY_PATH=     # absolute or ~/path to PKCS#8 (.p8) file

# Optional — only if the key is passphrase-protected.
# SNOWFLAKE_PASSPHRASE=
