{
  "name": "afd360",
  "version": "0.1.2",
  "description": "Manifest-driven IaC for Salesforce Data Cloud / Agentforce — declare connections, data streams, DMOs, mappings, and search indexes in TypeScript and deploy idempotently.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "afd360": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "templates",
    "examples",
    "skills",
    "docs",
    "README.md",
    "PRD.md",
    "AGENTS.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "clean": "rm -rf dist .afd360/plan.json",
    "release:check": "npm run typecheck && npm run test && npm run build",
    "release:version:patch": "npm version patch -m \"Bump package.json version to %s\"",
    "release:version:minor": "npm version minor -m \"Bump package.json version to %s\"",
    "release:version:major": "npm version major -m \"Bump package.json version to %s\"",
    "release:push": "git push origin main --follow-tags",
    "release:create": "gh release create \"v$npm_package_version\" --title \"v$npm_package_version\" --generate-notes",
    "release:run": "npm run release:check && npm run release:push && npm run release:create"
  },
  "dependencies": {
    "@salesforce/core": "^8.29.0",
    "commander": "^14.0.0",
    "data-360-sdk": "^0.2.9",
    "dotenv": "^17.4.2",
    "picocolors": "^1.1.1",
    "tsx": "^4.21.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "salesforce",
    "data-cloud",
    "data-360",
    "agentforce",
    "sdk",
    "iac",
    "manifest",
    "rag",
    "search-index",
    "dmo",
    "data-stream",
    "snowflake",
    "s3"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/javrrr/afd360.git"
  },
  "homepage": "https://github.com/javrrr/afd360#readme",
  "bugs": {
    "url": "https://github.com/javrrr/afd360/issues"
  },
  "author": "javrrr",
  "license": "MIT"
}
